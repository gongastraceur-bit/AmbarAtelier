// Cloudflare Workers — static demo deploy.
// Publishes only ./public. server.mjs is not used here, so the booking form
// runs in demo mode (simulated availability, nothing is stored or emailed).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ambar-atelier",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
